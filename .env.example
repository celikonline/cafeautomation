# Add these in Vercel Project > Settings > Environment Variables.
# Never put actual values in Git. Use separate database keys for Preview and Production.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=
# Vercel Marketplace can supply KV_REST_API_URL and KV_REST_API_TOKEN instead.
# Use one complete pair; do not copy or reveal integration secrets unnecessarily.
CAFE_QR_SECRET=
CAFE_ADMIN_USER=admin
CAFE_ADMIN_PASSWORD=
# Optional: stable custom domain. Without this, VERCEL_URL is used.
CAFE_PUBLIC_URL=https://your-cafe.vercel.app
CAFE_STORE_KEY=bahce:production
